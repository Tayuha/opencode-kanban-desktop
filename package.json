{
  "name": "opencode-kanban-desktop",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Kanban board for OpenCode Desktop: tasks, git worktrees, and agent sessions.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@opencode/client": "2.3.2",
    "@opencode/plugin": "2.3.2",
    "effect": "4.1.0"
  },
  "devDependencies": {
    "solid-js": "1.9.17",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-solid": "2.11.10",
    "vitest": "^4.1.12"
  }
}
